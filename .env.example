# Supabase project settings. Both public values are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never use NEXT_PUBLIC_ for secret keys.
SUPABASE_SECRET_KEY=

# Canonical origin used for invitations, redirects and CSRF checks.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Resend: use a sender address on a verified domain. Required for email invites.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Enable only after configuring Supabase Auth SMTP on the verified sender domain.
AUTH_EMAIL_ENABLED=false
